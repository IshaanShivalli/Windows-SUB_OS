{
  "id": "editor.lang.vyn",
  "name": "Operator Editor Vyn Extension",
  "version": "2.0.0",
  "runtime": "editor-extension",
  "entrypoint": "apps/nano.py",
  "deps": ["app.editor"],
  "signature": "SHA256:bf473b0be50f6c5d2c8e244a6c91096fdb949d49",
  "desc": "Vyn syntax highlighting, language-aware completions, and integration with the Vyn interpreter",
  "editor_extension": {
    "language": "Vyn",
    "file_extensions": [".vyn"],
    "completions": [
      "Class",
      "DOF",
      "Elif",
      "Else",
      "Err",
      "IF",
      "IN",
      "NIL",
      "None",
      "Ok",
      "Result",
      "Some",
      "break",
      "catch",
      "case",
      "const",
      "continue",
      "default",
      "do",
      "end",
      "endClass",
      "endFunc",
      "endLoop",
      "endLock",
      "endTimed",
      "false",
      "finally",
      "forIn",
      "forLoop",
      "function",
      "have",
      "if",
      "impl",
      "import",
      "lock",
      "lockGroup",
      "memcopy",
      "memdump",
      "memsize",
      "memzero",
      "nil",
      "not",
      "or",
      "perform",
      "print",
      "react",
      "repeatUntil",
      "return",
      "rollback",
      "snapshot",
      "struct",
      "switch",
      "timed",
      "throw",
      "true",
      "try",
      "union",
      "unlockAll",
      "watch",
      "whileLoop"
    ]
  }
}
